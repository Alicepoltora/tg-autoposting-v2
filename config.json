{
    "sources": [
        "@ILTVnews",
        "@hnaftali",
        "@Khabar_Fouri"
    ],
    "target": "@iraniumnew",
    "cleaning_rules": [
        {
            "pattern": "https?://\\S+",
            "replacement": "[LINK]"
        },
        {
            "pattern": "@[a-zA-Z0-9_]+",
            "replacement": ""
        },
        {
            "pattern": "#\\w+",
            "replacement": ""
        }
    ],
    "auto_translate": true
}